wazuh-install-files.tar
wazuh-passwords.txt
wazuh-certificates/

# Temporales e imágenes de instalación
*.iso
*.tmp
*.swp

# Sistema operativo
.DS_Store
Thumbs.db

# Las plantillas de ejemplo sí se versionan
!*.example
!*.example.*
