# Material de evidencias sin revisar: nunca se publica desde esta carpeta
evidence/_inbox/

# Secretos y credenciales
.env
.env.*
credentials.*
secrets.*
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ecdsa*
id_ed25519*

